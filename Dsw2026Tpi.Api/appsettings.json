{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Clinic": {
    "TimeZoneId": "America/Argentina/Buenos_Aires"
  },
  "ClinicalWrite": {
    "LockTimeoutMilliseconds": 5000
  },
  "NonWorkingDays": {
    "Dates": [
      "2026-01-01",
      "2026-02-16",
      "2026-02-17",
      "2026-03-24",
      "2026-04-02",
      "2026-04-03",
      "2026-05-01",
      "2026-05-25",
      "2026-06-15",
      "2026-06-20",
      "2026-07-09",
      "2026-08-17",
      "2026-10-12",
      "2026-11-09",
      "2026-11-23",
      "2026-12-08",
      "2026-12-25"
    ]
  },
  "RateLimiting": {
    "AdminLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "PatientLogin": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AppointmentBooking": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "General": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*.frt.utn.edu.ar"
}
